# Application
PORT=10000
ASPNETCORE_ENVIRONMENT=Development
APPLY_MIGRATIONS_ON_STARTUP=true

# Frontend
ClientApp__BaseUrl=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
# Използва се, когато API се стартира директно от host машината.
# docker-compose.yml заменя DB_CONNECTION с Host=db за API контейнера.
DB_CONNECTION=Host=localhost;Port=5434;Database=paladinhubv2db;Username=postgres;Password=change-me;

# Използват се от docker-compose.yml за PostgreSQL контейнера.
DB_NAME=paladinhubv2db
DB_USER=postgres
DB_PASSWORD=change-me
DB_PORT=5434

# Admin seeder
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe#2026!

# Stripe
# Остави празни, докато не добавиш реални Stripe test ключове.
STRIPE_MODE=Test
STRIPE__SECRETKEY_TEST=
STRIPE__PUBLISHABLEKEY_TEST=
STRIPE__SECRETKEY_LIVE=
STRIPE__PUBLISHABLEKEY_LIVE=

# Email
EMAIL__DELIVERYMODE=Console
EMAIL__SENDEREMAIL=noreply@paladinhubv2.local
EMAIL__SENDERNAME=PaladinHubV2
EMAIL__RESENDAPIKEY=
EMAIL__CONTACTRECIPIENTEMAIL=admin@example.com
EMAIL__PASSWORDRESETTOKENEXPIRYMINUTES=30