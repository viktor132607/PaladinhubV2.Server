<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SeoRefactorCoverage)' == 'true'">
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>json</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildProjectDirectory)/coverage/seo-refactor.json</CoverletOutput>
    <Threshold>100</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <Include>[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Seo.SeoService,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Seo.SeoTargetResolver,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Seo.SeoPublicSnapshotService,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Seo.SeoMutationLock,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Seo.SeoRequestValidator,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Seo.SeoEntryMapper,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Seo.SeoRevisionFactory,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Seo.SeoUrlPolicy</Include>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AccessControlRefactorCoverage)' == 'true'">
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>json</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildProjectDirectory)/coverage/access-control-refactor.json</CoverletOutput>
    <Threshold>100</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <Include>[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Roles.AccessControlAdminService,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Roles.AccessControlQueryService,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Roles.AccessControlRules,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Roles.AccessControlJournal</Include>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ProductRefactorCoverage)' == 'true'">
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>json</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildProjectDirectory)/coverage/product-refactor.json</CoverletOutput>
    <Threshold>100</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <Include>[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Products.ProductService,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Products.ProductCatalogQueryService,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Products.ProductSearchService,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Products.ProductSearchRules,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Products.ProductMutationService,[PaladinHubV2.Server.Domain]PaladinHubV2.Server.Domain.Services.Products.ProductReviewService</Include>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../PaladinHubV2.Server.API/PaladinHubV2.Server.API.csproj" />
  </ItemGroup>
</Project>
